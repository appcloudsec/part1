<#
  BrotliShell remediation update -> Word document (.docx)

  Builds the .docx directly as Office Open XML, so Microsoft Word does not
  need to be installed. Works in Windows PowerShell 5.1 and PowerShell 7+.

  Usage:   .\BrotliShell_Update.ps1
           (If blocked by policy: powershell -ExecutionPolicy Bypass -File .\BrotliShell_Update.ps1)

  To reuse for the next update, edit only the CONTENT section and run again.
  Inside single-quoted strings, write an apostrophe as two: ''
#>

$ErrorActionPreference = 'Stop'

# =============================== CONTENT ===============================

$OutName = 'BrotliShell_Update_2026-11-10.docx'

$Greeting = 'See below,'

$ExposureHeading = 'Exposure and Remediation'
$ExposureParagraphs = @(
    'The latest assessment from Vulnerability Resiliency identifies 37,837 affected assets, including 1,462 internet-exposed and 13,136 production assets, up from 30,098 in the previous update. These are counts of unique assets, not scan findings. Most of the increase appears to reflect wider Wiz scan coverage rather than new installs, and 5,200 assets have cleared scan results since November 5.'
    'The latest European tracking dashboard reports 91% remediation, with 4,853 assets marked remediated, up from 86% and 4,565 in the previous update.'
)

$TableHeader = @('Environment', 'Latest Remediation Status')
$TableRows = @(
    [pscustomobject]@{ Env = 'OneTru/OneDev'; Status = 'Wiz reporting now covers all of OneTru and identifies 6,476 affected assets, with 20 internet-reachable findings as the top priority. Deletion of non-production staging and QA VMs that the team cannot access is pending under OTCFDEVOPS-13074. OneDev, tracked separately, has 542 affected assets, none internet-exposed.' }
    [pscustomobject]@{ Env = 'RN/Bonafide';   Status = 'All highest-priority systems patched. Twenty production instances were targeted for patching or termination by November 10, with one additional instance awaiting a maintenance window. Confirmation of completion is pending.' }
    [pscustomobject]@{ Env = 'UK';            Status = 'External-facing remediation reported 99% complete; a Tanium scan identified one failed remediation, which is being worked as a priority. Internal remediation has increased to 90% and is on track for the November 11 deadline.' }
    [pscustomobject]@{ Env = 'Spain';         Status = 'Fully patched and validated.' }
    [pscustomobject]@{ Env = 'Monevo';        Status = 'External-facing and internal remediation both reported 100% complete. One externally exposed asset is still being investigated to clarify its exposure.' }
)

$DetectionHeading = 'Detection & Response'
$DetectionBullets = @(
    [pscustomobject]@{ Label = ''; Text = 'TDS extended the existing Cloudflare alert to cover BrotliShell. New CrowdStrike and Microsoft Defender for Endpoint detections are automatically ingested and alert to CDOC.' }
    [pscustomobject]@{ Label = ''; Text = 'CDOC reports no BrotliShell-related alerts or investigations to date.' }
)

$RisksHeading = 'Risks & Outstanding Work'
$RiskBullets = @(
    [pscustomobject]@{ Label = 'Internet-facing exposure:'; Text = 'The current assessment identifies 1,462 internet-exposed assets. This is a minimum, as internet exposure could not be determined for some assets.' }
    [pscustomobject]@{ Label = 'Remaining remediation:';    Text = 'UK internal systems, OneTru assets, and RN/Bonafide production instances remain in progress.' }
)

$Closing   = 'Thanks,'
$Signature = 'Powlos'

# ============================ LAYOUT / XML =============================

$Col1 = 2200   # table column widths in twips (1440 = 1 inch);
$Col2 = 7160   # Col1 + Col2 = 9360 = Letter width minus 1" margins

$BodyPPr    = '<w:spacing w:after="160" w:line="264" w:lineRule="auto"/>'
$HeadingPPr = '<w:keepNext/><w:spacing w:before="200" w:after="100"/>'
$BulletPPr  = '<w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:spacing w:after="80" w:line="264" w:lineRule="auto"/>'
$CellPPr    = '<w:spacing w:after="0" w:line="264" w:lineRule="auto"/>'
$ClosingPPr = '<w:spacing w:before="240" w:after="0"/>'

function ConvertTo-XmlText([string]$Text) {
    [System.Security.SecurityElement]::Escape($Text)
}

function New-WRun([string]$Text, [switch]$Bold) {
    $rPr = if ($Bold) { '<w:rPr><w:b/><w:bCs/></w:rPr>' } else { '' }
    '<w:r>' + $rPr + '<w:t xml:space="preserve">' + (ConvertTo-XmlText $Text) + '</w:t></w:r>'
}

function New-WPara([string]$Runs, [string]$PPr) {
    '<w:p><w:pPr>' + $PPr + '</w:pPr>' + $Runs + '</w:p>'
}

function New-WBullet($Item) {
    $runs = ''
    if ($Item.Label) { $runs += New-WRun ($Item.Label + ' ') -Bold }
    $runs += New-WRun $Item.Text
    New-WPara $runs $BulletPPr
}

function New-WCell([string]$Text, [int]$Width, [switch]$Bold, [switch]$Header) {
    $shd = if ($Header) { '<w:shd w:val="clear" w:color="auto" w:fill="D9E2F3"/>' } else { '' }
    '<w:tc><w:tcPr><w:tcW w:w="' + $Width + '" w:type="dxa"/>' + $shd + '</w:tcPr>' +
        (New-WPara (New-WRun $Text -Bold:$Bold) $CellPPr) + '</w:tc>'
}

function New-WTable {
    $b = 'w:val="single" w:sz="4" w:space="0" w:color="A6A6A6"'
    $xml = '<w:tbl><w:tblPr>' +
        '<w:tblW w:w="' + ($Col1 + $Col2) + '" w:type="dxa"/>' +
        '<w:tblBorders><w:top ' + $b + '/><w:left ' + $b + '/><w:bottom ' + $b + '/><w:right ' + $b + '/>' +
        '<w:insideH ' + $b + '/><w:insideV ' + $b + '/></w:tblBorders>' +
        '<w:tblLayout w:type="fixed"/>' +
        '<w:tblCellMar><w:top w:w="80" w:type="dxa"/><w:left w:w="120" w:type="dxa"/>' +
        '<w:bottom w:w="80" w:type="dxa"/><w:right w:w="120" w:type="dxa"/></w:tblCellMar>' +
        '</w:tblPr>' +
        '<w:tblGrid><w:gridCol w:w="' + $Col1 + '"/><w:gridCol w:w="' + $Col2 + '"/></w:tblGrid>'

    # Header row repeats on each page if the table breaks
    $xml += '<w:tr><w:trPr><w:cantSplit/><w:tblHeader/></w:trPr>' +
        (New-WCell $TableHeader[0] $Col1 -Bold -Header) +
        (New-WCell $TableHeader[1] $Col2 -Bold -Header) + '</w:tr>'

    foreach ($row in $TableRows) {
        $xml += '<w:tr><w:trPr><w:cantSplit/></w:trPr>' +
            (New-WCell $row.Env $Col1 -Bold) +
            (New-WCell $row.Status $Col2) + '</w:tr>'
    }
    $xml + '</w:tbl>'
}

# ---- document body ----
$body = New-Object System.Collections.Generic.List[string]
$body.Add((New-WPara (New-WRun $Greeting) $BodyPPr))

$body.Add((New-WPara (New-WRun $ExposureHeading -Bold) $HeadingPPr))
foreach ($p in $ExposureParagraphs) { $body.Add((New-WPara (New-WRun $p) $BodyPPr)) }
$body.Add((New-WTable))

$body.Add((New-WPara (New-WRun $DetectionHeading -Bold) $HeadingPPr))
foreach ($item in $DetectionBullets) { $body.Add((New-WBullet $item)) }

$body.Add((New-WPara (New-WRun $RisksHeading -Bold) $HeadingPPr))
foreach ($item in $RiskBullets) { $body.Add((New-WBullet $item)) }

$body.Add((New-WPara (New-WRun $Closing) $ClosingPPr))
$body.Add((New-WPara (New-WRun $Signature) $BodyPPr))

$DocumentXml =
    '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
    '<w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" ' +
    'xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><w:body>' +
    ($body -join '') +
    '<w:sectPr><w:pgSz w:w="12240" w:h="15840"/>' +
    '<w:pgMar w:top="1080" w:right="1440" w:bottom="1080" w:left="1440" w:header="720" w:footer="720" w:gutter="0"/>' +
    '</w:sectPr></w:body></w:document>'

# ---- static package parts ----
$ContentTypesXml = @'
<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/word/document.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml"/><Override PartName="/word/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.styles+xml"/><Override PartName="/word/numbering.xml" ContentType="application/vnd.openxmlformats-officedocument.wordprocessingml.numbering+xml"/></Types>
'@

$RootRelsXml = @'
<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="word/document.xml"/></Relationships>
'@

$DocRelsXml = @'
<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/><Relationship Id="rId2" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/numbering" Target="numbering.xml"/></Relationships>
'@

# Calibri 11 pt default font
$StylesXml = @'
<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<w:styles xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:docDefaults><w:rPrDefault><w:rPr><w:rFonts w:ascii="Calibri" w:hAnsi="Calibri" w:eastAsia="Calibri" w:cs="Calibri"/><w:sz w:val="22"/><w:szCs w:val="22"/><w:lang w:val="en-US"/></w:rPr></w:rPrDefault><w:pPrDefault><w:pPr><w:spacing w:after="0" w:line="240" w:lineRule="auto"/></w:pPr></w:pPrDefault></w:docDefaults><w:style w:type="paragraph" w:default="1" w:styleId="Normal"><w:name w:val="Normal"/><w:qFormat/></w:style><w:style w:type="table" w:default="1" w:styleId="TableNormal"><w:name w:val="Normal Table"/><w:uiPriority w:val="99"/><w:semiHidden/><w:unhideWhenUsed/><w:tblPr><w:tblInd w:w="0" w:type="dxa"/><w:tblCellMar><w:top w:w="0" w:type="dxa"/><w:left w:w="108" w:type="dxa"/><w:bottom w:w="0" w:type="dxa"/><w:right w:w="108" w:type="dxa"/></w:tblCellMar></w:tblPr></w:style></w:styles>
'@

# Bullet list definition (&#8226; is the bullet character)
$NumberingXml = @'
<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<w:numbering xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"><w:abstractNum w:abstractNumId="0"><w:multiLevelType w:val="hybridMultilevel"/><w:lvl w:ilvl="0"><w:start w:val="1"/><w:numFmt w:val="bullet"/><w:lvlText w:val="&#8226;"/><w:lvlJc w:val="left"/><w:pPr><w:ind w:left="720" w:hanging="360"/></w:pPr></w:lvl></w:abstractNum><w:num w:numId="1"><w:abstractNumId w:val="0"/></w:num></w:numbering>
'@

$Parts = [ordered]@{
    '[Content_Types].xml'          = $ContentTypesXml
    '_rels/.rels'                  = $RootRelsXml
    'word/document.xml'            = $DocumentXml
    'word/_rels/document.xml.rels' = $DocRelsXml
    'word/styles.xml'              = $StylesXml
    'word/numbering.xml'           = $NumberingXml
}

# ============================== WRITE FILE ==============================

$OutDir  = if ($PSScriptRoot) { $PSScriptRoot } else { (Get-Location).ProviderPath }
$OutFile = Join-Path $OutDir $OutName

Add-Type -AssemblyName System.IO.Compression

if (Test-Path -LiteralPath $OutFile) {
    try   { Remove-Item -LiteralPath $OutFile -Force }
    catch { throw "Cannot overwrite $OutFile - close it in Word and run the script again." }
}

$utf8NoBom  = New-Object System.Text.UTF8Encoding $false
$fileStream = [System.IO.File]::Open($OutFile, [System.IO.FileMode]::CreateNew)
try {
    $zip = New-Object System.IO.Compression.ZipArchive -ArgumentList $fileStream, ([System.IO.Compression.ZipArchiveMode]::Create)
    try {
        foreach ($name in $Parts.Keys) {
            $entryStream = $zip.CreateEntry($name).Open()
            $writer = New-Object System.IO.StreamWriter -ArgumentList $entryStream, $utf8NoBom
            try     { $writer.Write($Parts[$name]) }
            finally { $writer.Dispose() }
        }
    }
    finally { $zip.Dispose() }
}
finally { $fileStream.Dispose() }

Write-Host "Wrote $OutFile"
